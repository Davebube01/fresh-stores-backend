PROJECT_NAME="Goat Meat Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Postgres via Docker: `docker compose up postgres` starts it,
# matching the credentials in docker-compose.yml's postgres service.
DATABASE_URL="postgresql+asyncpg://meatstore:meatstore@localhost:5432/meatstore"

# SQLite fallback, if you'd rather not run Postgres locally at all:
# DATABASE_URL="sqlite+aiosqlite:///./sql_app.db"

# Staging / production: set the real connection string in that
# environment's own config (Neon, Render, etc.), not here.

# Optional Paystack Secret
PAYSTACK_SECRET_KEY="sk_test_..."

# Cloudinary (product image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
