PROJECT_NAME="Goat Meat Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Postgres via Docker: `docker compose up postgres` starts it,
# matching the credentials in docker-compose.yml's postgres service.
DATABASE_URL="postgresql+asyncpg://meatstore:meatstore@localhost:5432/meatstore"

# SQLite fallback, if you'd rather not run Postgres locally at all:
# DATABASE_URL="sqlite+aiosqlite:///./sql_app.db"

# Staging / production: set the real connection string in that
# environment's own config (Neon, Render, etc.), not here.

# First owner account: created at startup only while the store has no admin
# at all. Pick a strong password and change it after the first sign-in.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Store Owner"

# Optional Paystack Secret
PAYSTACK_SECRET_KEY="sk_test_..."

# Cloudinary (product image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Web Push (admin PWA). Generate a pair per environment — never reuse dev's:
#   python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); \
#     import base64; b64u=lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode(); \
#     pn=v.public_key.public_numbers(); \
#     print('VAPID_PUBLIC_KEY='+b64u(b'\x04'+pn.x.to_bytes(32,'big')+pn.y.to_bytes(32,'big'))); \
#     print('VAPID_PRIVATE_KEY='+b64u(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
# The public key is also needed by the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"
